{
  "compose_command": ["docker-compose"],
  "projects": {
    "stamp-app": {
      "enabled": false,
      "repository": "SamBzd/Stamp-app",
      "github_token_file": "/path/to/credentials/stamp-github-read",
      "compose_file": "/path/to/stamp-app/compose.yaml",
      "compose_version": "2.4",
      "trusted_workflows": {
        "SamBzd/Stamp-app/.github/workflows/nas-release.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256",
        "SamBzd/Stamp-app/.github/workflows/ci.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256",
        "SamBzd/Stamp-app/.github/workflows/nas-publish.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256"
      },
      "require_existing": true,
      "sqlite_migrations": {
        "service": "backend",
        "database_path": "/data/app.db"
      },
      "images": {
        "backend": "ghcr.io/sambzd/stamp-app-backend",
        "frontend": "ghcr.io/sambzd/stamp-app-frontend"
      },
      "preflight": {
        "service": "backend",
        "entrypoint": "node",
        "args": ["scripts/migrate-db.js", "--require-current"]
      },
      "probes": ["http://127.0.0.1:8080/", "http://127.0.0.1:8080/api/health"]
    },
    "calendrier-avent-maman-2026": {
      "enabled": false,
      "repository": "SamBzd/calendrier-avent-maman-2026",
      "github_token_file": "/path/to/credentials/calendrier-github-read",
      "compose_file": "/path/to/calendrier-avent-maman-2026/compose.yaml",
      "compose_version": "2.4",
      "trusted_workflows": {
        "SamBzd/calendrier-avent-maman-2026/.github/workflows/nas-release.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256",
        "SamBzd/calendrier-avent-maman-2026/.github/workflows/ci.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256",
        "SamBzd/Stamp-app/.github/workflows/nas-publish.yml": "REPLACE_WITH_REVIEWED_FILE_SHA256"
      },
      "images": {
        "web": "ghcr.io/sambzd/calendrier-avent-maman-2026-web"
      },
      "probes": ["http://127.0.0.1:8086/"]
    }
  }
}
